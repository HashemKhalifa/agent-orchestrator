{
  "name": "@bot/orchestrator-standalone",
  "version": "0.1.0",
  "description": "Standalone recipe-driven orchestration engine for migration/refactor workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "orchestrator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "dag:compile": "tsx src/cli.ts dag-compile",
    "dag:run": "tsx src/cli.ts dag-run",
    "rag:index": "tsx src/cli.ts rag-index",
    "rag:query": "tsx src/cli.ts rag-query",
    "eval:golden": "tsx src/cli.ts eval-golden",
    "eval:benchmark": "tsx src/cli.ts eval-benchmark",
    "recipe:generate": "tsx src/cli.ts recipe-generate",
    "autonomy:recipe-intake": "tsx src/cli.ts recipe-intake",
    "autonomy:auto-run": "tsx src/cli.ts auto-run",
    "autonomy:worker-enqueue": "tsx src/cli.ts worker-enqueue",
    "autonomy:worker-run": "tsx src/cli.ts worker-run",
    "autonomy:worker-status": "tsx src/cli.ts worker-status",
    "autonomy:synthesize": "tsx src/cli.ts synthesize-tasks",
    "skills:autogen": "tsx src/cli.ts skills-autogen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run src/**/*.test.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
